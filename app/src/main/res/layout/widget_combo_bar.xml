<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp"
    android:baselineAligned="false">

    <!-- Energy Section -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥗 Energy"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_combo_cal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 2000 kcal"
            android:textColor="#059669"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="8dp"
        android:background="#E2E8F0" />

    <!-- Water Section -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💧 Hydration"
            android:textColor="#0284C7"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_combo_water"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 3000 ml"
            android:textColor="#0F172A"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_btn_combo_water"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_btn_bg"
        android:paddingHorizontal="8dp"
        android:text="+250 ml"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>